#!/bin/bash

option=$1

if [ "$option" -eq 1 ]; then
    python train_patch.py \
        --base /home/sroychow/medimaging/dataset1 \
        --out /home/sroychow/medimaging/dataset1/outputs_patchnmf \
        --norm-mode global \
        --patch 16 --stride 8 \
        --block 16 \
        --k-list 10,20,30,50,75,100 \
        --max-iter 500 \
        --max-patches 250000
elif [ "$option" -eq 2 ]; then
    python train_patch.py \
        --base /home/sroychow/medimaging/dataset1 \
        --out /home/sroychow/medimaging/dataset1/outputs_patchnmf_normlocal \
        --norm-mode local --local-block 16 \
        --patch 16 --stride 8 \
        --block 16 \
        --k-list 10,20,30,50,75,100 \
        --max-iter 500 \
        --max-patches 250000
fi
