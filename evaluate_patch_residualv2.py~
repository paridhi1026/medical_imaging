#!/usr/bin/env python3
"""
Evaluate PatchNMF models with either z-score or quantile patch-residual scoring.

Fixes:
- --blockstats is OPTIONAL: inferred from model filename if possible.
- Supports: --mask-mode {zscore,quantile}
- Supports: --mask-lo-q / --mask-hi-q overrides
- Supports: --patch-batch (reconstruction batch size)
- Accepts: --io-ncore (compat; not used here)

NOTE: ROC/AUC require BOTH normal and anomalous samples.
If you evaluate on only normal images (or only anomalous), AUC will be NaN.
"""

import os
import re
import json
import argparse
from typing import Dict, List, Tuple

import numpy as np
import joblib
import matplotlib.pyplot as plt

from sklearn.metrics import roc_curve, auc

from nmfcore.config import Config
from nmfcore.data import list_images_flat
from nmfcore.preprocess import load_images_matrix


def ensure_dir(p: str) -> None:
    os.makedirs(p, exist_ok=True)


def block_mse_map(diff2_img: np.ndarray, block: int) -> np.ndarray:
    """Downsample a squared-residual image into (H/block, W/block) by block mean."""
    H, W = diff2_img.shape
    bh, bw = H // block, W // block
    if bh <= 0 or bw <= 0:
        raise ValueError(f"block={block} too large for image {H}x{W}")
    x = diff2_img[: bh * block, : bw * block].reshape(bh, block, bw, block)
    return x.mean(axis=(1, 3))


def infer_k_from_model_path(model_path: str) -> int | None:
    m = re.search(r"k(\d+)", os.path.basename(model_path))
    if not m:
        return None
    try:
        return int(m.group(1))
    except Exception:
        return None


def infer_blockstats_path(model_path: str) -> str | None:
    """Try to infer blockstats_k{K}.json next to the model."""
    k = infer_k_from_model_path(model_path)
    if k is None:
        return None
    d = os.path.dirname(model_path)
    cand = os.path.join(d, f"blockstats_k{k}.json")
    return cand if os.path.exists(cand) else None


def load_blockstats(path: str) -> Dict:
    with open(path, "r") as f:
        b = json.load(f)
    for key in ["block", "eps", "mu", "sigma", "mask_lo_q", "mask_hi_q"]:
        if key not in b:
            raise ValueError(f"blockstats missing key '{key}': {path}")
    return b


def compute_scores(
    bundle,
    X: np.ndarray,
    cfg: Config,
    bstats: Dict,
    *,
    recon_batch: int = 16,
    score_mode: str = "zscore",
    score_quantile: float = 0.99,
    mask_lo_q: float | None = None,
    mask_hi_q: float | None = None,
) -> Tuple[np.ndarray, List[np.ndarray], np.ndarray]:
    """
    Returns:
      scores: (N,) float32
      maps: list of (bh,bw) residual maps
      Xrec: (N,D) reconstructed images
    """
    s = cfg.img_size
    block = int(bstats["block"])
    eps = float(bstats.get("eps", 1e-8))

    mu = np.array(bstats["mu"], dtype=np.float32)
    sigma = np.array(bstats["sigma"], dtype=np.float32)

    lo_q = float(mask_lo_q if mask_lo_q is not None else bstats.get("mask_lo_q", 20.0))
    hi_q = float(mask_hi_q if mask_hi_q is not None else bstats.get("mask_hi_q", 99.5))

    Xrec = bundle.reconstruct_images(X, batch=int(recon_batch))

    scores = np.zeros((X.shape[0],), dtype=np.float32)
    maps: List[np.ndarray] = []

    for i in range(X.shape[0]):
        img = X[i].reshape(s, s)
        lo = np.percentile(img, lo_q)
        hi = np.percentile(img, hi_q)
        mask = ((img > lo) & (img < hi)).astype(np.float32)

        diff2 = ((X[i] - Xrec[i]) ** 2).reshape(s, s) * mask
        m = block_mse_map(diff2, block).astype(np.float32)
        maps.append(m)

        if score_mode == "zscore":
            z = (m - mu) / (sigma + eps)
            scores[i] = float(z.mean())
        elif score_mode == "quantile":
            q = float(np.clip(score_quantile, 0.0, 1.0))
            scores[i] = float(np.quantile(m.reshape(-1), q))
        else:
            raise ValueError(f"Unknown score_mode: {score_mode}")

    return scores, maps, Xrec


def plot_roc(y_true: np.ndarray, y_score: np.ndarray, title: str, out_png: str) -> float:
    if len(np.unique(y_true)) < 2:
        plt.figure(figsize=(6, 5))
        plt.title(f"{title} (AUC=nan)")
        plt.xlabel("False Positive Rate")
        plt.ylabel("True Positive Rate")
        plt.grid(True)
        plt.tight_layout()
        plt.savefig(out_png, dpi=150)
        plt.close()
        return float("nan")

    fpr, tpr, _ = roc_curve(y_true, y_score)
    roc_auc = auc(fpr, tpr)

    plt.figure(figsize=(6, 5))
    plt.plot(fpr, tpr)
    plt.plot([0, 1], [0, 1], linestyle="--")
    plt.title(f"{title} (AUC={roc_auc:.4f})")
    plt.xlabel("False Positive Rate")
    plt.ylabel("True Positive Rate")
    plt.grid(True)
    plt.tight_layout()
    plt.savefig(out_png, dpi=150)
    plt.close()

    return float(roc_auc)


def best_threshold(y_true: np.ndarray, y_score: np.ndarray) -> Tuple[float, Dict[str, int]]:
    """Pick threshold that maximizes Youden's J (tpr - fpr)."""
    if len(np.unique(y_true)) < 2:
        thr = float(np.quantile(y_score, 0.99))
        y_pred = (y_score >= thr).astype(int)
        tn = int(((y_true == 0) & (y_pred == 0)).sum())
        fp = int(((y_true == 0) & (y_pred == 1)).sum())
        fn = int(((y_true == 1) & (y_pred == 0)).sum())
        tp = int(((y_true == 1) & (y_pred == 1)).sum())
        return thr, {"tn": tn, "fp": fp, "fn": fn, "tp": tp}

    fpr, tpr, thr = roc_curve(y_true, y_score)
    j = tpr - fpr
    k = int(np.argmax(j))
    best_thr = float(thr[k])

    y_pred = (y_score >= best_thr).astype(int)
    tn = int(((y_true == 0) & (y_pred == 0)).sum())
    fp = int(((y_true == 0) & (y_pred == 1)).sum())
    fn = int(((y_true == 1) & (y_pred == 0)).sum())
    tp = int(((y_true == 1) & (y_pred == 1)).sum())

    return best_thr, {"tn": tn, "fp": fp, "fn": fn, "tp": tp}


def save_debug(out_dir: str, prefix: str, X: np.ndarray, cfg: Config, maps: List[np.ndarray], scores: np.ndarray, *, n: int = 10):
    ensure_dir(out_dir)
    s = cfg.img_size
    idx = np.linspace(0, len(scores) - 1, num=min(n, len(scores)), dtype=int)

    for j, i in enumerate(idx):
        img = X[i].reshape(s, s)
        m = maps[i]

        plt.figure(figsize=(10, 4))
        plt.subplot(1, 2, 1)
        plt.imshow(img, cmap="gray")
        plt.title("Input (scaled)")
        plt.axis("off")

        plt.subplot(1, 2, 2)
        plt.imshow(m, cmap="hot")
        plt.title(f"Patch residual map ({prefix})\nscore={scores[i]:.4g}")
        plt.axis("off")
        plt.colorbar(fraction=0.046, pad=0.04)

        out = os.path.join(out_dir, f"debug_{prefix}_i{j:05d}.png")
        plt.tight_layout()
        plt.savefig(out, dpi=150)
        plt.close()


def main():
    ap = argparse.ArgumentParser()

    ap.add_argument("--base", required=True, help="Dataset root")
    ap.add_argument("--img-size", type=int, default=128)
    ap.add_argument("--norm-mode", choices=["global", "local"], default="global")
    ap.add_argument("--local-block", type=int, default=8)

    ap.add_argument("--test-normal", required=True, help="Folder with normal test images")
    ap.add_argument("--test-anom", required=True, help="Folder with anomalous test images")

    ap.add_argument("--model", required=True, help=".joblib PatchNMFBundle")
    ap.add_argument("--blockstats", default=None, help="blockstats_k?.json (optional; inferred if omitted)")

    ap.add_argument("--mask-mode", choices=["zscore", "quantile"], default="zscore")
    ap.add_argument("--score-quantile", type=float, default=0.99, help="Used when --mask-mode quantile")
    ap.add_argument("--mask-lo-q", type=float, default=None, help="Override blockstats mask_lo_q")
    ap.add_argument("--mask-hi-q", type=float, default=None, help="Override blockstats mask_hi_q")

    ap.add_argument("--patch-batch", type=int, default=16, help="Reconstruction batch size")
    ap.add_argument("--io-ncore", type=int, default=1, help="Accepted for compatibility (not used here)")

    ap.add_argument("--out", required=True)
    ap.add_argument("--debug", action="store_true")
    ap.add_argument("--debug-n", type=int, default=10)

    args = ap.parse_args()
    ensure_dir(args.out)

    cfg = Config(
        base_path=args.base,
        img_size=args.img_size,
        normal_class="",
        norm_mode=args.norm_mode,
        local_block=args.local_block,
        random_state=0,
    )

    bundle = joblib.load(args.model)

    bpath = args.blockstats or infer_blockstats_path(args.model)
    if not bpath:
        raise SystemExit(
            "--blockstats was not provided and could not be inferred from the model filename. "
            "Provide --blockstats /path/to/blockstats_k?.json"
        )
    if not os.path.exists(bpath):
        raise SystemExit(f"blockstats file not found: {bpath}")
    bstats = load_blockstats(bpath)

    normal_paths = list_images_flat(args.test_normal)
    anom_paths = list_images_flat(args.test_anom)
    if len(normal_paths) == 0:
        raise SystemExit(f"No images found in --test-normal: {args.test_normal}")
    if len(anom_paths) == 0:
        raise SystemExit(f"No images found in --test-anom: {args.test_anom}")

    Xn, _ = load_images_matrix(normal_paths, cfg)
    Xa, _ = load_images_matrix(anom_paths, cfg)

    scores_n, maps_n, _ = compute_scores(
        bundle, Xn, cfg, bstats,
        recon_batch=args.patch_batch,
        score_mode=args.mask_mode,
        score_quantile=args.score_quantile,
        mask_lo_q=args.mask_lo_q,
        mask_hi_q=args.mask_hi_q,
    )
    scores_a, maps_a, _ = compute_scores(
        bundle, Xa, cfg, bstats,
        recon_batch=args.patch_batch,
        score_mode=args.mask_mode,
        score_quantile=args.score_quantile,
        mask_lo_q=args.mask_lo_q,
        mask_hi_q=args.mask_hi_q,
    )

    y_true = np.concatenate([np.zeros_like(scores_n, dtype=int), np.ones_like(scores_a, dtype=int)])
    y_score = np.concatenate([scores_n, scores_a]).astype(np.float32)

    roc_path = os.path.join(args.out, "roc.png")
    title = f"ROC ({os.path.basename(args.model)})"
    roc_auc = plot_roc(y_true, y_score, title, roc_path)

    thr, cm = best_threshold(y_true, y_score)

    metrics = {
        "model": os.path.abspath(args.model),
        "blockstats": os.path.abspath(bpath),
        "norm_mode": args.norm_mode,
        "local_block": int(args.local_block),
        "img_size": int(args.img_size),
        "mask_mode": args.mask_mode,
        "score_quantile": float(args.score_quantile),
        "mask_lo_q": float(args.mask_lo_q) if args.mask_lo_q is not None else float(bstats.get("mask_lo_q", 20.0)),
        "mask_hi_q": float(args.mask_hi_q) if args.mask_hi_q is not None else float(bstats.get("mask_hi_q", 99.5)),
        "n_normal": int(len(scores_n)),
        "n_anom": int(len(scores_a)),
        "auc": float(roc_auc),
        "thr": float(thr),
        "confusion": cm,
        "scores_normal": {
            "mean": float(np.mean(scores_n)),
            "std": float(np.std(scores_n)),
            "min": float(np.min(scores_n)),
            "max": float(np.max(scores_n)),
        },
        "scores_anom": {
            "mean": float(np.mean(scores_a)),
            "std": float(np.std(scores_a)),
            "min": float(np.min(scores_a)),
            "max": float(np.max(scores_a)),
        },
    }

    with open(os.path.join(args.out, "metrics.json"), "w") as f:
        json.dump(metrics, f, indent=2)

    if args.debug:
        k = infer_k_from_model_path(args.model) or "k"
        save_debug(args.out, f"patchres_{k}_{args.mask_mode}", Xn, cfg, maps_n, scores_n, n=args.debug_n)

    print("Saved:")
    print(" ", roc_path)
    print(" ", os.path.join(args.out, "metrics.json"))
    print(f"AUC={roc_auc}  thr={thr}")


if __name__ == "__main__":
    main()
